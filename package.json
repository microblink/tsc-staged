{
  "name": "tsc-staged",
  "version": "0.0.0",
  "description": "Type-check TypeScript projects affected by staged files.",
  "keywords": [
    "lint-staged",
    "nano-staged",
    "staged",
    "tsc-files",
    "typecheck",
    "typescript"
  ],
  "homepage": "https://github.com/microblink/tsc-staged#readme",
  "bugs": {
    "url": "https://github.com/microblink/tsc-staged/issues"
  },
  "license": "Apache-2.0",
  "author": "Microblink Ltd.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microblink/tsc-staged.git"
  },
  "bin": {
    "tsc-staged": "dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "check": "vp check && vp test && pnpm test:e2e",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint --max-warnings=0",
    "prepack": "vp pack",
    "release": "changeset publish",
    "test": "vp test",
    "test:coverage": "c8 vp test",
    "test:e2e": "node scripts/package-check.mts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "^24.13.3",
    "@typescript/native": "npm:typescript@~7.0.2",
    "c8": "12.0.0",
    "lefthook": "~2.1.10",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "typescript": ">=6 <8"
  },
  "c8": {
    "all": true,
    "exclude": [
      "src/**/*.test.ts"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "reporter": [
      "text",
      "html",
      "json-summary"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0"
}
